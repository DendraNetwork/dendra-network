# Dendra — public launch .env (template).
# Do not fill this file inside the repo: run `deploy/launch/launch_env_check.sh --init`, which generates
# ~/.dendra-launch.env (outside the repo) with strong secrets. This template documents the knobs.
#
# The code's fail-closed guards refuse to boot if these are missing under DENDRA_PUBLIC=1:
#   gateway : empty/weak/default key   -> refuse
#   relay   : missing / <16-char token -> refuse
#   faucet  : PoW <= 0                  -> refuse

# --- Exposure switch (arms all fail-closed guards) ---
DENDRA_PUBLIC=1

# --- Network identity. The one place the chain id is written: the chain, the services and the
# launcher read it from here, and nothing defaults it. ---
DENDRA_CHAIN_ID=dendra-testnet

# --- Cold pockets: addresses only, generated offline; the keys never touch the host.
# The launcher refuses a public launch while community, team or delegation is empty. Payout may stay
# empty: it is then a service key on the host, holding the account that pays the Final Testnet Season
# (PAY_AMT in docker/entrypoint-chain.sh, more than the season cap; cap_season bounds what is paid). ---
DENDRA_COMMUNITY_ADDR=
DENDRA_TEAM_ADDR=
DENDRA_DELEGATION_ADDR=
DENDRA_PAYOUT_ADDR=

# --- Secrets (generated by --init; never committed) ---
DENDRA_API_KEY=__GENERATED_BY_INIT__
DENDRA_RELAY_TOKEN=__GENERATED_BY_INIT__
# Final Testnet Season: the generator reports trap results to the programme service with
# this token, on a route Caddy never proxies.
DENDRA_FINAL_SEASON_INTERNAL_TOKEN=__GENERATED_BY_INIT__
# Final Testnet Season: the first grader (final_season_grader.py on the owner's machine, where a GPU is)
# reads a sample of the answers to the programme's requests and posts its grades with this token, through
# /final-season/v1/grading/. Keep it off every public surface.
DENDRA_FINAL_SEASON_GRADER_TOKEN=__GENERATED_BY_INIT__
# The second grader, on the chain host's CPU (compose profile grader-cpu; final_season_server.py binds this
# token to the grader name "cpu" and every grade records that name, never the token). Empty: no second
# grader. Not generated by --init: set it when the second grader is deployed, after the measurement
# (dendra/onchain-staging/dendra_grade_measure.sh), with `openssl rand -hex 24`, here and in the host's .env.
DENDRA_FINAL_SEASON_GRADER_CPU_TOKEN=
# What the CPU grader's engine (grader-ollama-cpu) may take of the host: an assumption until the measurement
# says otherwise (docker-compose.yml, profile grader-cpu). Set both from what the measurement prints.
DENDRA_GRADER_CPU_MEM_LIMIT=1g
DENDRA_GRADER_CPU_CPUS=1

# --- Final Testnet Season programme. The chain, the programme and the application start
# together: the season's first block is the chain's first block. The generator's address is not written
# here: the chain creates that key at genesis, and the launcher reads it and adds
# DENDRA_FINAL_SEASON_GENERATOR to the host.
DENDRA_FINAL_SEASON_START_HEIGHT=1
# The unwound-audit rule set (final_season_rules.RULES: the work of an unwound audit is paid) applies from the day
# named here. The service fixes it the first time it starts with the rule and records it (decision-18.json on its
# data volume); left
# empty, it takes the first day not yet ranked at that start, which depends on when the redeploy happens.
# A day already ranked is refused, and the service then stops: a date of effect is never moved in silence.
DENDRA_FINAL_SEASON_UNWOUND_WORK_FROM_DAY=1
# The doubled rates (final_season_rules.RULES_DOUBLED: twice the rewards, the daily cap and the season cap)
# apply from the day named here to the end of the season. The service fixes it the first time it starts with
# it and records it (doubled-rates.json on its data volume). Until that record exists the value is required:
# a day number, or none for no doubled day; left empty, the service stops instead of ranking the next day at
# the old rates. A day already ranked, or before the unwound-audit day above, is refused and the service stops.
DENDRA_FINAL_SEASON_DOUBLED_FROM_DAY=4
# The more-requests rule set (final_season_rules.RULES_MORE_REQUESTS: a larger requests_per_day, the doubled rates and
# caps unchanged) applies from the day named here to the end of the season, recorded once like the doubled day
# (more-requests.json). Required until then: a day number, or none, which is not recorded and must stay here at
# every start. A day already ranked, or before the doubled day, is refused and the service stops.
DENDRA_FINAL_SEASON_MORE_REQUESTS_FROM_DAY=6
# The kit rule set (final_season_rules.RULES_KIT: the judge presence reward, the refusal of a kit below the kit
# floor and the probation of new identities) applies from the day named here to the end of the
# season, recorded once like the sets before (kit-rules.json). Required until then: a day number (the season day
# that begins closest to KIT_DEADLINE, fixed before it begins, read in the service's status) or none, which is not recorded and must
# stay here at every start. A day already ranked, or before the more-requests day, is refused and the service stops, and
# so is a day that has begun when the service fixes it (the set reads the capacity registry during each day it
# applies to, so the day must come after the start that fixes it: name it before its first block). The set
# carries the kit floor: DENDRA_KIT_MIN below is required at the start that fixes the day, recorded with it, and
# must name the same number afterwards or be left empty.
DENDRA_FINAL_SEASON_KIT_RULES_FROM_DAY=none
# The kit floor and its deadline, the two keys network-info.txt publishes
# (deploy/testnet/publish_network.sh): the kit number of the release the announcement names (docker/KIT_VERSION at
# that release) and the announcement's instant plus seven days, in UTC, as YYYY-MM-DDThh:mm:ssZ. From the
# deadline the relay refuses a kit below the floor and the faucet a request that declares a kit below it; the
# season, from the first day of the set above. Both empty: the refusal is dormant and every kit is served. One
# without the other: the services refuse to start. The faucet reads the field `kit_version` in the grant
# request's JSON body and serves a body without it, since the wallet page, gateway_fund.py and join_validator.sh
# send none (services/faucet.py::H.do_POST). The relay refuses a deposit without it: set the two
# only once the kit that joins signs it into its deposits, or every joining kit is refused from the deadline.
DENDRA_KIT_MIN=
DENDRA_KIT_DEADLINE=

# --- Prebuilt miner image: not set here. network-info.txt is served over plain HTTP, so it does not name
# code a joiner runs; the digest the release workflow prints (miner-image.txt) goes into docker/MINER_IMAGE,
# committed and published with the tree, where deploy/join.sh reads it.

# --- Faucet anti-Sybil (>= 18 bits; 20 = ~1 s of client compute, Sybil drain priced out) ---
DENDRA_FAUCET_POW_BITS=20
# One drip = the chain's min_stake, read from the chain: enough for one miner identity,
# never several. A number here would outlive a change of min_stake.
DENDRA_FAUCET_AMOUNT=min_stake
DENDRA_FAUCET_IP_DAILY=2
DENDRA_FAUCET_ADDR_COOLDOWN=86400
DENDRA_FAUCET_DAILY_CAP=2000

# --- Service keyrings. The faucet and the gateway each sign from their own keyring volume (faucet-keys,
# gateway-keys), which no other service mounts. The chain creates their keys at genesis in its shared keyring
# (service-keys); each service adopts its key from there once, at a start where this variable is service-keys:
# compose then mounts that keyring read-only into both (docker/entrypoint-services.sh, adopt_service_key).
# Leave it empty here: launch_public.sh sets it in the host's .env before it starts the stack and clears it at
# step 7b, recreating the faucet and the gateway, on a fresh genesis and on every other run. Set it by hand only
# for a deployment that does not go through launch_public.sh, for one start, then empty it again and recreate
# both: while it is set, each of them can read the other's key. Empty or service-keys, nothing else: the value
# names the volume compose mounts.
DENDRA_SERVICE_KEYS_SEED=

# --- Chat front-end: not served on the validator host (opt-in compose profile `chat`).
# Kept True so that starting the profile anywhere can never expose an open chat by accident.
WEBUI_AUTH=True

# --- Internal ports. Docker publishes ports through its own firewall rules, which ufw does
# not filter: a port bound to 0.0.0.0 in docker-compose.yml is public whatever ufw says. gRPC has no
# public consumer, so on the validator host it listens on loopback only.
DENDRA_GRPC_BIND=127.0.0.1

# --- Audit / judge ---
# 20 % at the relaunch; raised to 5000 by governance once four jurors vote.
DENDRA_AUDIT_SAMPLE_BPS=2000
# Audit resolution timeout: > p95 of the real 5th verdict (calibrate on day one).
DENDRA_AUDIT_RESOLVE_TIMEOUT=240
DENDRA_JUDGE_ABSTAIN_VOTE=1
# Availability-slash stays dormant until proven false-positive-free in the real world (never 1 at launch).
DENDRA_AVAIL_SLASH=0

# --- Moderation ---
# The only content filter is a deterministic in-process regex floor (incl. the CSAM pattern), always on.
# The optional LLM classifier stage (llama-guard) is off here because DENDRA_GUARD_MODEL is unset, and this
# file deliberately leaves it unset. It is available, not unreachable: content_filter.py reads that variable
# and arms the stage when it is set. Posture = research/testnet, not a legal-compliance guarantee.

# --- Points ratio (exclude subsidy addresses from the numerator and the use bucket) ---
DENDRA_R2_EXCLUDE_ADDRS=

# --- Public facades (The Proof / points, compose profile `public`) ---
DENDRA_PROOF_CORS=https://dendranetwork.com
DENDRA_POINTS_CORS=https://dendranetwork.com
# The public chat gateway's address: the account its key opens jobs from (the `client` of those jobs on chain).
# The Proof's origin partition (the_proof.py::origin_partition) splits the jobs between the season generator
# (address read from the season service's status), this gateway and every other client. Left empty, the gateway's
# count and the other clients' count are null and the partition says the address is not set; it never guesses one.
DENDRA_PROOF_GATEWAY_ADDRESS=

# --- HTTPS front (Caddy reverse proxy: testnet-api. / testnet-proof.dendranetwork.com) ---
# Gateway CORS: let the site's in-page chat (browser, https://dendranetwork.com) call the gateway cross-origin.
DENDRA_CORS_ORIGIN=https://dendranetwork.com
# Open WebUI public URL, read only if the opt-in `chat` profile is started somewhere with its own proxy.
WEBUI_URL=https://chat.dendranetwork.com
