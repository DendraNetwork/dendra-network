# ============================================================================
#  Dendra — testnet node config.  Copy this file to  .env  then fill it in.
#      cp .env.example .env
# ============================================================================

# --- Network (provided by the operator / the testnet page) ---
CHAIN_ID=dendra
MONIKER=my-dendra-node

# URL of the PUBLIC genesis.json (frozen by the operator)
GENESIS_URL=https://FILL_ME/genesis.json

# EXPECTED genesis sha256 (given in network-info.txt) -> anti-MITM check MANDATORY (the node REFUSES to
# start if empty). TRUSTED network only: set DENDRA_ALLOW_UNVERIFIED_GENESIS=1 to skip the check.
GENESIS_SHA256=FILL_ME_sha256

# Public seeds: "<node_id>@<host>:26656" (multiple, comma-separated)
SEEDS=NODEID_FILL_ME@SEED_HOST:26656

# Persistent peers (optional): same format as SEEDS
PERSISTENT_PEERS=

# --- STATE-SYNC trust point (published by the operator in network-info.txt) ---
# Leave the three EMPTY on a fresh network: the node then replays the history, which is safe there.
# Fill them as soon as the chain has taken a consensus-breaking change: replaying that history
# recomputes an AppHash that differs from the signed one and the node PANICS. The three values go
# together — node-join.sh activates state-sync only when all three are set, and says so when they are
# missing. They were forwarded by docker-compose.yml and consumed by node-join.sh but had no field
# here, so an operator on this manual path had nowhere to put what the operator published.
STATESYNC_RPC=
STATESYNC_TRUST_HEIGHT=
STATESYNC_TRUST_HASH=

# --- Escape hatches (both default to 0; each disables a guard, so each is written down) ---
# The network was RESET and this node still carries the old chain: it would keep running a dead fork
# while reporting catching_up=false. node-join.sh refuses to start on that divergence. Set to 1 to let
# it drop the local chain data and resync (KEYS ARE KEPT — only the chain state is dropped).
DENDRA_AUTO_RESET_ON_GENESIS_CHANGE=0
# Skip the anti-MITM genesis check (see GENESIS_SHA256 above). TRUSTED networks only.
DENDRA_ALLOW_UNVERIFIED_GENESIS=0

# --- Validator only: VRF key file (vote extensions) ---
# Written for you by deploy/bond_validator.sh. A bonded validator whose VRF key is not anchored does
# NOT contribute to the randomness beacon — the node looks perfectly healthy while the committee seed
# stays as centralised as it was.
DENDRA_VRF_KEY_FILE=
