# ============================================================================
#  Dendra — testnet node config.  Copy this file to  .env  then fill it in.
#      cp .env.example .env
# ============================================================================

# --- Network (provided by the operator / the testnet page) ---
CHAIN_ID=
MONIKER=my-dendra-node

# URL of the PUBLIC genesis.json (frozen by the operator)
GENESIS_URL=https://FILL_ME/genesis.json

# EXPECTED genesis sha256 (given in network-info.txt) -> anti-MITM check MANDATORY (the node REFUSES to
# start if empty). TRUSTED network only: set DENDRA_ALLOW_UNVERIFIED_GENESIS=1 to skip the check.
GENESIS_SHA256=FILL_ME_sha256

# Public seeds: "<node_id>@<host>:26656" (multiple, comma-separated)
SEEDS=NODEID_FILL_ME@SEED_HOST:26656

# Persistent peers (optional): same format as SEEDS
PERSISTENT_PEERS=

# Advertised to PEERS so they can dial back. Leave it EMPTY unless port 26656 is genuinely
# reachable from outside: a node with no external address announces 0.0.0.0:26656, which nobody
# can dial — it still syncs, it simply never becomes a redundancy option for anyone else.
# The node REFUSES to start on a wildcard, loopback or private value: peers store what you
# advertise and re-gossip it, so a wrong address costs other operators, not just you.
#   DENDRA_EXTERNAL_ADDRESS=203.0.113.9:26656
DENDRA_EXTERNAL_ADDRESS=

# --- RPC bind address (26657) ---
# Unset = 127.0.0.1: the RPC is reachable from this host only. A miner kit on the same machine reaches
# the node on the `dendra-chain` Docker network, by its project name, and needs nothing more. Set 0.0.0.0
# ONLY for a node that serves a public RPC (an operator's DENDRA_NODE, a STATESYNC_RPC for joiners).
# DENDRA_RPC_BIND=0.0.0.0

# --- STATE-SYNC trust point ---
# deploy/join.sh writes these for a NEW node, derived over TLS from the servers docker/STATESYNC_RPC
# names in the clone. On this manual path they are yours to fill, from those servers and never from
# network-info.txt, which travels over plain HTTP: the trust point decides which chain the node joins.
# Empty = the node replays the history from the genesis. Needed as soon as the chain has taken a
# consensus-breaking change: replaying that history recomputes an AppHash that differs from the signed
# one and the node PANICS. The three values go together — node-join.sh activates state-sync only when
# all three are set (and only when it creates the home), and says so when they are missing.
# STATESYNC_GENESIS_SHA256 binds them to a genesis: node-join.sh applies the trust point only when it
# equals GENESIS_SHA256, so a home recreated after a network reset never takes the previous network's.
STATESYNC_RPC=
STATESYNC_TRUST_HEIGHT=
STATESYNC_TRUST_HASH=
STATESYNC_GENESIS_SHA256=

# --- Escape hatches (both default to 0; each disables a guard, so each is written down) ---
# The network was RESET and this node still carries the old chain: it would keep running a dead fork
# while reporting catching_up=false. node-join.sh refuses to start on that divergence. Set to 1 to let
# it drop the local chain data and resync (KEYS ARE KEPT — only the chain state is dropped).
DENDRA_AUTO_RESET_ON_GENESIS_CHANGE=0
# Skip the anti-MITM genesis check (see GENESIS_SHA256 above). TRUSTED networks only.
DENDRA_ALLOW_UNVERIFIED_GENESIS=0

# --- Validator only: VRF key file (vote extensions) ---
# Written for you by deploy/bond_validator.sh. A bonded validator whose VRF key is not anchored does
# NOT contribute to the randomness beacon — the node looks perfectly healthy while the committee seed
# stays as centralised as it was.
DENDRA_VRF_KEY_FILE=
