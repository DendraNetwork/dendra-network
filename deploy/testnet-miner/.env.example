# ============================================================================
#  Dendra — testnet miner config.  Copy this file to  .env  then fill it in.
#      cp .env.example .env
# ============================================================================

# --- PUBLIC testnet endpoints (provided by the network operator) ---
#  Ask the operator for them, or get them from the testnet page.

# CHAIN RPC — where this miner reads the chain and sends its transactions.
#
#  RECOMMENDED, and what `deploy/join.sh` sets up on its own: run YOUR OWN node next to the miner and
#  put  tcp://host.docker.internal:26657  here. `join.sh` starts the node (deploy/testnet-node), waits
#  for it to catch up, and writes this value for you. Nothing else to do.
#
#  Why it is worth the disk it costs: a miner reading someone else's RPC has to TRUST what it is told
#  about the chain, goes blind the moment that endpoint stops, and can be shown a filtered view. You
#  already keep this machine running — it is the natural place for a node.
#
#  The address below is the fallback: the operator's public RPC (`join.sh --remote-rpc`). It works, and
#  it makes this miner depend on one machine it does not control.
DENDRA_NODE=tcp://RPC_PUBLIC_FILL_ME:26657
DENDRA_RELAY=http://RELAY_PUBLIC_FILL_ME:8645
FAUCET=http://FAUCET_PUBLIC_FILL_ME:4500

# --- RELAY TOKEN: ASK THE OPERATOR FOR IT. A public relay runs with auth ON. ---
#  Without it every request is answered 401, the client swallows the error, and the miner concludes
#  "no jobs" and waits forever: registered on-chain, holding a jury seat, never served — and silent.
#  Leave it empty ONLY for a closed testnet whose relay runs without auth.
DENDRA_RELAY_TOKEN=

# --- FAUCET PROOF OF WORK (public network) ---
#  A public faucet requires a proof of work bound to your address. The miner reads the required
#  difficulty from the faucet itself and solves it at startup — nothing to fill in here. Raise the
#  solving time limit only if the operator picked a very high difficulty (default 300 s).
# DENDRA_FAUCET_POW_MAX_S=300

# --- PINNED model served by the network (must match the on-chain registry) ---
#  This is THE model that will be downloaded LOCALLY on your machine and served by your GPU.
DENDRA_MODEL_ID=llama3.1:8b-instruct-q4_K_M

# --- VERIFICATION embedder: REAL SEMANTIC (not the lexical bag-of-words) ---
#  On-chain verification compares embeddings. In "backend" mode, the miner embeds via Ollama (/api/embeddings)
#  with a DEDICATED embedding model -> we measure MEANING, not just shared words. All miners in a
#  committee must use the SAME one (keep these values).
DENDRA_EMBED_MODE=backend
DENDRA_EMBED_API_MODEL=nomic-embed-text

# --- YOUR miner's identity (unique on the network; keep it stable) ---
MINER_ID=m-change-me

# --- AUDIT COMMITTEE (optional; needs a second, CPU-only Ollama -- start with `--profile judge`) ---
#  DENDRA_JUDGE_MODEL_ID  is the model DECLARED in your on-chain verdicts, and the FALLBACK used when
#                         the chain pins none. It does NOT beat the on-chain pin.
#  DENDRA_JUDGE_MODEL_OVERRIDE forces the model actually run by the judge (highest precedence).
#  Precedence: OVERRIDE > on-chain pin (modelregistry.audit_judge_model) > _MODEL_ID > built-in default.
#  Never qwen3:4b as a judge: it false-slashes honest miners in a distributed setting.
# DENDRA_MINER_JUDGE=1
# DENDRA_JUDGE_ENDPOINT=http://ollama-cpu:11434
# DENDRA_JUDGE_MODEL_ID=qwen3:30b-a3b-instruct-2507-q4_K_M
# DENDRA_JUDGE_MODEL_OVERRIDE=
