# Dendra Python services image: relay, OpenAI-compatible gateway, miners, exporter, CLI.
# dendrad (the chain binary) is taken from the 'dendra/chain' image to sign and query through DENDRA_NODE;
# it is therefore stamped with the version that image was built with, and `dendrad version` reports it here too.
# Build: docker compose build   (after 'docker compose build chain', which produces dendra/chain:latest)
FROM python:3.12-slim

RUN pip install --no-cache-dir cryptography requests prometheus_client

WORKDIR /app
COPY services/ /app/
COPY docker/entrypoint-services.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /data/keys

# Chain binary (miners and clients shell out to dendrad). Requires dendra/chain:latest to be built first.
COPY --from=dendra/chain:latest /go/bin/dendrad /usr/local/bin/dendrad

ENV DENDRA_RELAY="http://relay:8645" \
    OLLAMA_ENDPOINT="http://ollama:11434" \
    DENDRA_NODE="tcp://chain:26657" \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["/entrypoint.sh"]
