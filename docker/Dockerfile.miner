# Standalone miner image (dendrad binary + Python miner client) to join a remote Dendra testnet.
# Multi-stage: builds dendrad from chain, then a slim Python runtime. It depends on no prebuilt
# image (Dockerfile.services, by contrast, does COPY --from=dendra/chain).
# Build context = repository root. This build is not exercised by CI; validate it on your host.

# --- Stage 1: chain binary (the miner shells out to dendrad to sign and query through DENDRA_NODE) ---
FROM golang:1.25-bookworm AS chainbuild
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The compiler is the one pinned by the `toolchain` directive of chain/go.mod, not the one that
# happens to ship in this base image. The official golang images set GOTOOLCHAIN=local, which turns
# the directive into a no-op and builds the chain with a different compiler than CI and the releases.
# `auto` puts go.mod back in charge; the version is never named here, so nothing has to be kept in
# sync when the pin moves.
ENV GOTOOLCHAIN=auto

# Version stamped into the binary. Without it `dendrad version` prints an empty line and an operator
# cannot tell which build is running. The injection is the one used by .github/workflows/release.yml:
# the value travels through -ldflags and is never written into a tracked file, so the tree that gets
# built is exactly the tree that was checked out.
#   docker build --build-arg VERSION="$(git describe --tags --match 'v[0-9]*' --always)" \
#                --build-arg COMMIT="$(git rev-parse HEAD)" -f docker/Dockerfile.miner .
ARG VERSION=dev
ARG COMMIT=unknown

WORKDIR /chain
COPY chain/ /chain/
# -trimpath, -buildvcs=false and CGO_ENABLED=0 mirror the release workflow, so the binary in this
# image is byte-for-byte the published release binary for the same tag and platform: its SHA-256 can
# be checked against the release SHA256SUMS.binaries. Dropping any of the three breaks that property.
# CGO_ENABLED=0 also yields the static binary that the slim runtime stage below expects.
RUN ( CGO_ENABLED=0 go build -trimpath -buildvcs=false \
        -ldflags "-X github.com/cosmos/cosmos-sdk/version.Name=dendra \
                  -X github.com/cosmos/cosmos-sdk/version.AppName=dendrad \
                  -X github.com/cosmos/cosmos-sdk/version.Version=${VERSION} \
                  -X github.com/cosmos/cosmos-sdk/version.Commit=${COMMIT}" \
        -o /go/bin/dendrad ./cmd/dendrad ) \
    || ( echo "dendrad build failed -> check ./cmd/dendrad in chain (see docker/README.md)"; exit 1 )

# dendra-vrf is the miner's ECVRF utility (cmd/dendra-vrf/main.go: "produces and verifies ECVRF proofs on
# the miner side"). A miner that intends to be paid for availability needs it.
#
# Why it must be in this image: the vrf_pubkey is anchored at registration, and under verification_mode=1
# (the incentivised configuration) the chain closes the GPU-less echo: ProveAvailability returns
# ErrUnauthorized for any miner whose vrf_pubkey is empty, and payAvailability skips it as well. A miner
# whose image lacks this binary registers without a key and can never prove availability, while serving
# jobs and reporting itself healthy. The client cannot detect this at startup, because it does not know
# whether the chain it joins runs the incentivised configuration.
#
# The rule is therefore structural: an image ships every binary its code invokes by absolute path. The
# image-binaries guard of the development repository enforces it.
RUN ( CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /go/bin/dendra-vrf ./cmd/dendra-vrf ) \
    || ( echo "dendra-vrf build failed -> check ./cmd/dendra-vrf in chain"; exit 1 )

# --- Stage 2: miner runtime (slim) ---
FROM python:3.12-slim
RUN pip install --no-cache-dir cryptography requests prometheus_client
WORKDIR /app
COPY services/ /app/
# The gates this image was built for. deploy/testnet-miner/miner_health.sh reads them inside the running
# container and compares them with the clone and with what the network publishes, so an image started
# from an older pin inside a newer clone is reported rather than guessed. Copying the two files also makes
# the image change whenever a gate moves.
COPY docker/KIT_VERSION docker/CONSENSUS_EPOCH /app/built-for/
COPY docker/entrypoint-services.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /data/keys
COPY --from=chainbuild /go/bin/dendrad /usr/local/bin/dendrad
COPY --from=chainbuild /go/bin/dendra-vrf /usr/local/bin/dendra-vrf
ENV PYTHONUNBUFFERED=1
# The healthcheck says one thing: whether the daemon's loop is moving, i.e. its heartbeat is younger than
# modea/heartbeat.py::max_age_s. It is only a display: Docker restarts nothing on it, and it has two states
# where the self-test has three, so the verdict stays with deploy/testnet-miner/miner_health.sh. It lives
# in the image rather than the compose file so that an image built before the heartbeat existed shows no
# health at all instead of a false "unhealthy". The start period covers a first start, when the faucet's
# proof of work and the registration run before the loop does.
HEALTHCHECK --interval=60s --timeout=20s --start-period=15m --retries=3 \
  CMD ["python3", "/app/miner_selftest.py", "--heartbeat"]
ENTRYPOINT ["/entrypoint.sh"]
