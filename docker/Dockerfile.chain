# Dendra TESTNET Cosmos node: the `dendrad` binary, compiled here and run NATIVELY (`dendrad start`)
# against a FROZEN genesis assembled on first boot by entrypoint-chain.sh. No ignite at runtime.
# Build context = repository ROOT.
# Go: go.mod declares its own toolchain and carries a `tool` block (Go 1.24+); older toolchains fail here.
FROM golang:1.25-bookworm

# jq patches the genesis (jobs/emission params + model registry) from the entrypoint. git resolves Go modules.
RUN apt-get update && apt-get install -y --no-install-recommends git curl build-essential ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*

# The compiler is the one pinned by the `toolchain` directive of chain/go.mod, not the one that
# happens to ship in this base image. The official golang images set GOTOOLCHAIN=local, which makes
# the directive a no-op and builds the chain with a different compiler than CI and than every release
# -- the second source of truth the pin exists to prevent, and it drifts without a word. Restoring
# `auto` puts go.mod back in charge; the version is never named here, so there is nothing to keep
# in sync when the pin moves.
ENV GOTOOLCHAIN=auto

# Version stamped into the binary. Without it `dendrad version` prints an empty line and an operator
# cannot tell which build is running. The injection is the one used by .github/workflows/release.yml:
# the value travels through -ldflags and is never written into a tracked file, so the tree that gets
# built is exactly the tree that was checked out.
#   docker build --build-arg VERSION="$(git describe --tags --always)" \
#                --build-arg COMMIT="$(git rev-parse HEAD)" -f docker/Dockerfile.chain .
ARG VERSION=dev
ARG COMMIT=unknown

WORKDIR /chain
COPY chain/ /chain/
# `dendrad` -> /go/bin (required by the COPY in Dockerfile.services). FAIL-FAST: a broken build stops
# the image HERE, instead of producing a dendrad-less image whose COPY fails much further away.
# -trimpath, -buildvcs=false and CGO_ENABLED=0 mirror the release workflow, so the binary in this
# image is byte-for-byte the published release binary for the same tag and platform: its SHA-256 can
# be checked against the release SHA256SUMS.binaries. Dropping any of the three breaks that property.
RUN cd /chain && CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags "-X github.com/cosmos/cosmos-sdk/version.Name=dendra \
                -X github.com/cosmos/cosmos-sdk/version.AppName=dendrad \
                -X github.com/cosmos/cosmos-sdk/version.Version=${VERSION} \
                -X github.com/cosmos/cosmos-sdk/version.Commit=${COMMIT}" \
      -o /go/bin/dendrad ./cmd/dendrad
# VRF bootstrap: dendra-vrf (keygen/prove/pubkey) ships in the image so the entrypoint can anchor the
# validator's VRF key on its own. It carries no cosmos version variables, only the reproducibility flags.
RUN cd /chain && CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /go/bin/dendra-vrf ./cmd/dendra-vrf

COPY docker/entrypoint-chain.sh /entrypoint-chain.sh
RUN chmod +x /entrypoint-chain.sh

EXPOSE 26657 26656 1317 9090
ENTRYPOINT ["/entrypoint-chain.sh"]
