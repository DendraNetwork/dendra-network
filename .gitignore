# Everything below is regenerated by a build, a run, or a tool — never authored, never reviewed.

# --- Python: bytecode and virtualenvs, rebuilt by the interpreter and by pip ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/
*.egg-info/

# --- Go / build: compiler and test output, rebuilt by `go build` / `go test` ---
/build/
*.test
*.out

# Node binary only. Patterns are ANCHORED (leading `/`): an unanchored `dendrad` would also match the
# directory `chain/cmd/dendrad/`, the node entry point every Dockerfile compiles, and drop it silently.
/dendrad
/chain/dendrad
/chain/build/

# Go vendor directory at the module root. Anchored for the same reason: an unanchored `vendor/` would
# also match `wallet/web/vendor/`, the CosmJS bundle the web wallet serves.
/chain/vendor/

# --- Runtime and chain state: produced by a running node, never committed ---
*.log
.dendra/
*.dendra/
data/
node_data/

# --- Secrets: private keys, mnemonics and local environment (`.env.example` is the committed template) ---
keyring-*/
keyring-passphrase
*.mnemonic
*.key
*.pem
.env
!.env.example

# THE RECOVERY PHRASE OF A VALIDATOR, AND THE PATTERNS ABOVE DO NOT CATCH IT.
# `deploy/bond_validator.sh` writes the operator's recovery phrase to
# `deploy/testnet-node/validator-key-backup.json` — inside the tree a joiner clones — and tells them to
# move it somewhere safe. Until they do, one `git add -A` stages it: the file ends in `.json`, so
# `*.mnemonic`, `*.key` and `*.pem` all miss it. Whoever holds that phrase controls the bonded stake,
# and the keyring backend is `test`, i.e. unencrypted on disk.
# This repository's source has carried the rule for a long time; it had never been carried across to
# the tree that strangers clone — the same gap `.gitattributes` was found in, in the same generator.
validator-key-backup*
deploy/*/validator-key-backup*

# --- State the kit's watches write next to their kit: machine state, never source ---
# deploy/validator_health.sh --cron writes validator-health.ALERT in deploy/testnet-node/;
# deploy/testnet-miner/miner_health.sh --cron writes miner-health.ALERT and miner-health.last.json in
# deploy/testnet-miner/, and exit-miner.sh its miner-health.EXITED marker. An alert carries the operator's
# full report: one `git add -A` would otherwise commit it.
validator-health.ALERT
deploy/*/validator-health.ALERT
miner-health.*
deploy/*/miner-health.*
deploy/*/.miner-health.*

# --- The default mount of the miner's keyring passphrase: an EMPTY directory Docker creates next to the
# kit when the .env names no secrets directory (deploy/testnet-miner/docker-compose.yml). The passphrase
# itself lives outside the clone, in ~/.config/dendra/miner-secrets.
deploy/testnet-miner/secrets/

# --- One identity per card (deploy/join.sh --gpus): the slots join.sh writes next to the kit. Machine files:
# gpu/<k>/.env carries the relay token, gpu/<k>/override.yml the card's UUID (a unique hardware identifier).
deploy/testnet-miner/gpu/
# And slot 0's own GPU override, which join.sh writes next to the kit: with --gpus it names slot 0's card by
# that same UUID.
deploy/*/docker-compose.override.yml

# --- Owner mode: the unsigned exit exit-miner.sh --yes writes next to the kit, and the file the owner signs
# (deploy/testnet-miner/exit-miner.sh).
deploy/testnet-miner/delete-miner*.json
# The other transactions the owner signs, written by the operator's own redirection where the command runs:
# the daemon prints `... > create-miner.json` (then update-miner.json), and payout-prepare is run
# `> payout.json` from the kit's directory (deploy/testnet-miner/README.md, owner mode).
deploy/testnet-miner/create-miner*.json
deploy/testnet-miner/update-miner*.json
deploy/testnet-miner/payout*.json

# --- Local benchmark output and scratch files ---
bench-results/
/tmp/
*.tmp

# --- OS and editor metadata ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Build integrity marker: written by the release build, read by the publication procedure, and kept
# out of the repository — a release artifact does not document its own toolchain.
.build-complete
